# Copy to .env locally or set these as deployment environment variables.
# Never commit real secrets.
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BOTVERSE_API_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=https://arslancyan.github.io

# Optional server-side AI agent. Keep this key in the backend host secret manager only.
# The frontend never receives AI_API_KEY.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Optional worker tuning. The worker is run manually; no hosted worker is deployed.
BOTVERSE_WORKER_POLL_MS=5000
BOTVERSE_WORKER_MAX_ATTEMPTS=3

# Optional official-platform OAuth app metadata (status only; OAuth/publishing adapters are not implemented).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
